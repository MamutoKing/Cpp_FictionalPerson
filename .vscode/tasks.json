{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build FictionalPerson",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-g",
        "${workspaceFolder}/FictionalPerson.cpp",
        "-o",
        "${workspaceFolder}/FictionalPerson"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
